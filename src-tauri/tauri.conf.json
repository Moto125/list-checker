{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "list-checker",
  "version": "1.0.1",
  "identifier": "com.moto.list-checker",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "list-checker",
        "width": 640,
        "height": 480,
        "backgroundColor": "#e5e7eb"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
